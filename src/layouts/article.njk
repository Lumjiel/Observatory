---
layout: base.njk
---
<link rel="stylesheet" href="/assets/css/article-detail.css">
<script>if(window.innerWidth<=768){var vp=document.querySelector('meta[name="viewport"]');if(vp)vp.setAttribute('content','width=device-width,initial-scale=0.75,viewport-fit=cover');}</script>
<div class="article-page">
    <div class="terminal-header">
        <span class="terminal-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
        </span>
        <span class="terminal-title">{{ article.slug }}.md</span>
    </div>

    <nav class="article-breadcrumb">
        <span class="prompt-icon">$</span>
        <a href="{{ env.BASE_PATH }}/">cd ~</a>
        <span class="separator">/</span>
        <a href="{{ env.BASE_PATH }}/articles/?category={{ article.category }}" class="breadcrumb-category" data-category="{{ article.category }}">{{ article.category }}</a>
        <span class="separator">/</span>
        <span class="current">{{ article.slug }}</span>
    </nav>

    <article class="article-container">
        <header class="article-header">
            <div class="article-title-wrap">
                <span class="title-prefix">#</span>
                <h1 class="article-title">{{ article.title }}</h1>
            </div>
            <div class="article-meta">
                <span class="meta-item">
                    <span class="meta-icon">📅</span>
                    <span class="meta-value">发布: {{ article.date }}</span>
                </span>
                {% if article.updated %}
                <span class="meta-item">
                    <span class="meta-icon">✏️</span>
                    <span class="meta-value">更新: {{ article.updated | formatDate }}</span>
                </span>
                {% endif %}
                <span class="meta-item">
                    <span class="meta-icon">⏱</span>
                    <span class="meta-value">{{ article.readingTime }}</span>
                </span>
                <a href="{{ env.BASE_PATH }}/articles/{{ article.category }}/" class="meta-item meta-category">
                    <span class="meta-icon">📁</span>
                    <span class="meta-value">{{ article.category | categoryLabel }}</span>
                </a>
            </div>
            <div class="article-tags">
                {% for tag in article.tags %}
                <span class="tag">#{{ tag }}</span>
                {% endfor %}
            </div>
        </header>

        <div class="article-content">
            {{ content | safe }}
        </div>

        <footer class="article-footer">
            {% if article.source === 'log' and article.sourceLogId %}
            <section class="related-section">
                <div class="section-header">
                    <span class="section-icon">📎</span>
                    <h3>关联日志</h3>
                </div>
                <p class="related-desc">$ cat <code>{{ article.sourceLogId }}</code>.log</p>
            </section>
            {% endif %}

            <div class="back-to-list">
                <a href="{{ env.BASE_PATH }}/articles/" class="back-link">
                    <span class="back-arrow">←</span>
                    <span>返回文章列表</span>
                </a>
            </div>

            <div class="article-nav">
                {% set foundCurrent = false %}
                {% set prevArticle = null %}
                {% set nextArticle = null %}
                {% set foundNext = false %}
                {% for a in collections.published %}
                    {% if foundNext and not nextArticle %}
                        {% set nextArticle = a %}
                    {% endif %}
                    {% if a.slug == article.slug and a.category == article.category %}
                        {% set foundCurrent = true %}
                    {% elif not foundCurrent %}
                        {% set prevArticle = a %}
                    {% elif foundNext == false %}
                        {% set foundNext = true %}
                    {% endif %}
                {% endfor %}
                {% if prevArticle %}
                <a href="{{ env.BASE_PATH }}/articles/{{ prevArticle.category }}/{{ prevArticle.slug }}/" class="nav-link prev">
                    <span class="nav-arrow">←</span>
                    <span class="nav-label">prev</span>
                    <span class="nav-title">{{ prevArticle.title }}</span>
                </a>
                {% endif %}
                {% if nextArticle %}
                <a href="{{ env.BASE_PATH }}/articles/{{ nextArticle.category }}/{{ nextArticle.slug }}/" class="nav-link next">
                    <span class="nav-label">next</span>
                    <span class="nav-arrow">→</span>
                    <span class="nav-title">{{ nextArticle.title }}</span>
                </a>
                {% endif %}
            </div>

            <div class="article-end-marker">
                <span class="end-line">───</span>
                <span class="end-text">END OF ARTICLE</span>
                <span class="end-line">───</span>
            </div>
        </footer>
    </article>

    <button class="back-to-top" id="backToTop" title="返回顶部">↑</button>
</div>


<script>
(function() {
    var btn = document.getElementById('backToTop');
    if (!btn) return;
    window.addEventListener('scroll', function() {
        if (window.scrollY > 400) {
            btn.classList.add('visible');
        } else {
            btn.classList.remove('visible');
        }
    });
    btn.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });
})();
</script>