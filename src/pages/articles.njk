---
layout: base.njk
title: "文章列表"
permalink: /articles/
---

<link rel="stylesheet" href="/assets/css/articles.css">

<div class="articles-page">
    <div class="terminal-header">
        <span class="terminal-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
        </span>
        <span class="terminal-title">articles.sh</span>
    </div>

    <header class="page-header">
        <div class="command-line">
            <span class="prompt">$</span>
            <span class="command">ls -la ./articles/</span>
        </div>
        <h1 class="page-title">📚 文章列表</h1>
        <p class="page-subtitle">共找到 {{ collections.published.length }} 篇文章</p>
    </header>

    <div class="sort-controls">
        <span class="sort-label">$ sort -</span>
        <button class="sort-btn active" data-sort="desc">最新</button>
        <button class="sort-btn" data-sort="asc">最早</button>
    </div>

    <div class="filter-toolbar">
        <div class="search-box">
            <span class="search-prompt">$ grep -i "</span>
            <input type="text" id="articleSearch" class="search-input" placeholder="搜索文章..." autocomplete="off">
            <span class="search-prompt">" ./articles/</span>
        </div>
        <div class="tag-filter" id="tagFilter"></div>
    </div>

    <div class="articles-list" id="articlesList">
        {% for article in collections.published %}
        <article class="article-card"
                 data-category="{{ article.category }}"
                 data-date="{{ article.date }}"
                 data-title="{{ article.title | lower }}"
                 data-tags="{{ article.tags | join(',') | lower }}"
                 data-excerpt="{{ article.excerpt | lower }}">
            <a href="/articles/{{ article.category }}/{{ article.slug }}/" class="article-link">
                <div class="article-meta-row">
                    <span class="article-category {{ article.category }}">{{ article.category | categoryLabel }}</span>
                    <span class="article-date">{{ article.date }}</span>
                    <span class="article-time">⏱ {{ article.readingTime }}</span>
                </div>
                <h2 class="article-title">
                    <span class="title-icon">📄</span>
                    {{ article.title }}
                </h2>
                <p class="article-excerpt">{{ article.excerpt }}</p>
                <div class="article-footer-row">
                    <div class="article-tags">
                        {% for tag in article.tags %}
                        <span class="tag">#{{ tag }}</span>
                        {% endfor %}
                    </div>
                    <span class="read-more">阅读 →</span>
                </div>
            </a>
        </article>
        {% endfor %}

        {% if collections.published.length === 0 %}
        <div class="empty-state">
            <div class="empty-icon">📭</div>
            <p class="empty-message">暂无文章</p>
            <p class="empty-hint">
                <span class="prompt">$</span> mkdir src/articles/{category}/<br>
                <span class="comment"># 将 Markdown 文件放入分类目录即可自动导入</span>
            </p>
        </div>
        {% endif %}
    </div>

    <div class="pagination" id="pagination"></div>

    <div class="page-footer">
        <span class="end-line">───</span>
        <span class="end-text">END OF LIST</span>
        <span class="end-line">───</span>
    </div>
</div>

<script>
(function() {
    var searchInput = document.getElementById('articleSearch');
    var tagFilter = document.getElementById('tagFilter');
    var articlesList = document.getElementById('articlesList');
    var paginationEl = document.getElementById('pagination');
    var countEl = document.querySelector('.page-subtitle');
    var sortBtns = document.querySelectorAll('.sort-btn');
    var cards = Array.from(document.querySelectorAll('.article-card'));

    if (!searchInput || !cards.length) return;

    var PAGE_SIZE = 10;
    var currentPage = 1;
    var activeTag = null;
    var currentSort = 'desc';

    // 收集所有标签
    var allTags = {};
    cards.forEach(function(card) {
        var tags = (card.dataset.tags || '').split(',');
        tags.forEach(function(t) {
            t = t.trim();
            if (t) allTags[t] = (allTags[t] || 0) + 1;
        });
    });

    // 渲染 tag chips（按数量排序，最多 10 个）
    var sortedTags = Object.keys(allTags).sort(function(a, b) { return allTags[b] - allTags[a]; });
    tagFilter.innerHTML = sortedTags.slice(0, 10).map(function(t) {
        return '<span class="tag-chip" data-tag="' + t + '">#' + t + '</span>';
    }).join('');

    // 获取筛选后的卡片
    function getFilteredCards() {
        var query = searchInput.value.toLowerCase().trim();
        return cards.filter(function(card) {
            var matchText = !query ||
                (card.dataset.title || '').indexOf(query) !== -1 ||
                (card.dataset.tags || '').indexOf(query) !== -1 ||
                (card.dataset.excerpt || '').indexOf(query) !== -1;
            var matchTag = !activeTag ||
                (card.dataset.tags || '').split(',').map(function(s) { return s.trim(); }).indexOf(activeTag) !== -1;
            return matchText && matchTag;
        });
    }

    // 渲染分页按钮
    function renderPagination(total) {
        var totalPages = Math.ceil(total / PAGE_SIZE);
        if (totalPages <= 1) { paginationEl.innerHTML = ''; return; }

        var html = '';
        html += '<button ' + (currentPage === 1 ? 'disabled' : '') + ' data-page="' + (currentPage - 1) + '">←</button>';

        var maxVisible = 5;
        var start = Math.max(1, currentPage - Math.floor(maxVisible / 2));
        var end = Math.min(totalPages, start + maxVisible - 1);
        if (end - start < maxVisible - 1) start = Math.max(1, end - maxVisible + 1);

        if (start > 1) {
            html += '<button data-page="1">1</button>';
            if (start > 2) html += '<span class="page-info">...</span>';
        }
        for (var i = start; i <= end; i++) {
            html += '<button class="' + (i === currentPage ? 'active' : '') + '" data-page="' + i + '">' + i + '</button>';
        }
        if (end < totalPages) {
            if (end < totalPages - 1) html += '<span class="page-info">...</span>';
            html += '<button data-page="' + totalPages + '">' + totalPages + '</button>';
        }

        html += '<button ' + (currentPage === totalPages ? 'disabled' : '') + ' data-page="' + (currentPage + 1) + '">→</button>';
        html += '<span class="page-info">' + currentPage + '/' + totalPages + '</span>';
        paginationEl.innerHTML = html;

        paginationEl.querySelectorAll('button').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var page = parseInt(this.dataset.page);
                if (page && page !== currentPage) {
                    currentPage = page;
                    applyFilters();
                    articlesList.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    }

    // 主渲染
    function applyFilters() {
        var filtered = getFilteredCards();
        filtered.sort(function(a, b) {
            var da = new Date(a.dataset.date);
            var db = new Date(b.dataset.date);
            return currentSort === 'asc' ? da - db : db - da;
        });

        var total = filtered.length;
        var startIdx = (currentPage - 1) * PAGE_SIZE;
        var pageCards = filtered.slice(startIdx, startIdx + PAGE_SIZE);

        cards.forEach(function(card) { card.style.display = 'none'; });
        pageCards.forEach(function(card) { card.style.display = ''; });

        if (countEl) countEl.textContent = '共找到 ' + total + ' 篇文章';
        renderPagination(total);
    }

    // 排序按钮
    sortBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            var sort = this.dataset.sort;
            if (sort === currentSort) return;
            currentSort = sort;
            currentPage = 1;
            sortBtns.forEach(function(b) { b.classList.remove('active'); });
            this.classList.add('active');
            applyFilters();
        });
    });

    // 搜索
    searchInput.addEventListener('input', function() { currentPage = 1; applyFilters(); });

    // Tag 筛选
    tagFilter.addEventListener('click', function(e) {
        var chip = e.target.closest('.tag-chip');
        if (!chip) return;
        var tag = chip.dataset.tag;
        if (activeTag === tag) {
            activeTag = null;
            chip.classList.remove('active');
        } else {
            tagFilter.querySelectorAll('.tag-chip').forEach(function(c) { c.classList.remove('active'); });
            activeTag = tag;
            chip.classList.add('active');
        }
        currentPage = 1;
        applyFilters();
    });

    // 初始渲染
    applyFilters();
})();
</script>
